# ============================================================
# HomeAgent 后端配置示例
#
# 使用方法：复制本文件为 .env（项目根目录）后按需修改。
# .env 已被 .gitignore 忽略，不会提交到仓库。
#
# 优先级：真实环境变量 > .env 文件；变量名不区分大小写。
# 嵌套配置用 "." 分隔（pydantic-settings env_nested_delimiter），
# 前缀 LLM / ASR 用于区分不同服务。
# ============================================================

# ---------- LLM：火山引擎 豆包（agent plan）----------
# 必填！API Key，手动填写（控制台获取后粘贴到这里）
LLM.API_KEY=

# OpenAI 兼容端点（agent plan 专用通道）
LLM.BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# 模型 ID
LLM.MODEL=doubao-seed-2.1-lite

# ---------- ASR：qwen3-asr Docker 服务 ----------
# OpenAI 兼容端点（asr/docker-compose.yml 暴露的本机端口）
ASR.BASE_URL=http://127.0.0.1:12301/v1

# ---------- Web 服务（可选，一般不用改）----------
# HOST=127.0.0.1
# PORT=8000
# DEBUG=false

# ---------- LAN：局域网设备管理 ----------
# 网段自动检测失败时的回退网段（正常情况启动时自动检测并覆盖，见启动日志）
LAN.NETWORK=192.168.3.0/24

# 仪表盘在线状态轮询间隔（秒），默认 5，最小不低于 1
LAN.PING_INTERVAL=5

# nmap 可执行文件路径；留空则按 PATH 查找（缺失时端口扫描降级不可用）
# LAN.NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
